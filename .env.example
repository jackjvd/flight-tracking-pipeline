# OpenSky API client credentials (https://opensky-network.org/my-opensky/account).
# Leave both blank to use anonymous access, which has much lower rate limits.
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# Area to track: lamin,lomin,lamax,lomax. Blank means Switzerland in Docker and
# the whole world for local runs. The whole world costs 4x more OpenSky credits.
OPENSKY_BBOX=

# Where raw extracts are written.
OUTPUT_DIR=data/raw

# Warehouse Postgres (docker compose). Inside the Airflow container the host is
# "warehouse"; from your machine it is localhost.
WAREHOUSE_USER=flights
WAREHOUSE_PASSWORD=flights
WAREHOUSE_DB=flights
WAREHOUSE_URL=postgresql://flights:flights@localhost:5432/flights
# Used by dbt when you run it locally.
WAREHOUSE_HOST=localhost
WAREHOUSE_PORT=5432
